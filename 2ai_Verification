import numpy as np

def get_stream(probability, length):
    """Generates an independent stochastic bit stream."""
    return (np.random.rand(length) < probability).astype(int)

def simulate_problem_2ai_single_trial(stream_length):
    """Runs a single simulation of the 27-gate circuit."""
    # We must generate fresh, independent streams every time we use a 0.4 or 0.5 
    # to avoid statistical correlation
    w1  = 1 - get_stream(0.4, stream_length)
    w2  = w1 & get_stream(0.5, stream_length)
    w3  = w2 & get_stream(0.5, stream_length)
    w4  = w3 & get_stream(0.4, stream_length)
    w5  = 1 - w4
    w6  = w5 & get_stream(0.5, stream_length)
    w7  = w6 & get_stream(0.4, stream_length)
    w8  = 1 - w7
    w9  = w8 & get_stream(0.5, stream_length)
    w10 = 1 - w9
    w11 = w10 & get_stream(0.5, stream_length)
    w12 = w11 & get_stream(0.5, stream_length)
    w13 = w12 & get_stream(0.4, stream_length)
    w14 = 1 - w13
    w15 = w14 & get_stream(0.5, stream_length)
    w16 = w15 & get_stream(0.4, stream_length)
    w17 = 1 - w16
    w18 = w17 & get_stream(0.5, stream_length)
    w19 = 1 - w18
    w20 = w19 & get_stream(0.5, stream_length)
    w21 = w20 & get_stream(0.4, stream_length)
    w22 = 1 - w21
    w23 = w22 & get_stream(0.5, stream_length)
    w24 = 1 - w23
    w25 = w24 & get_stream(0.5, stream_length)
    w26 = w25 & get_stream(0.4, stream_length)
    
    # Final Inverter
    final_output = 1 - w26
    
    return np.mean(final_output)

def run_multiple_trials(num_trials=100, stream_length=5000000):
    print(f"Starting {num_trials} trials for Target: 0.8881188")
    print(f"Stream length per trial: {stream_length:,} bits")
    print("This might take a minute...\n")
    
    results = []
    
    for i in range(num_trials):
        sim_prob = simulate_problem_2ai_single_trial(stream_length)
        results.append(sim_prob)
        
        # Print progress every 10 trials
        if (i + 1) % 10 == 0:
            print(f"Completed {i + 1} / {num_trials} trials...")
            
    # Calculate statistics over the 100 trials
    average_prob = np.mean(results)
    min_prob = np.min(results)
    max_prob = np.max(results)
    
    print("\n" + "="*40)
    print("FINAL RESULTS")
    print("="*40)
    print(f"Target Probability    : 0.8881188")
    print(f"Average Simulated Prob: {average_prob:.7f}")
    print(f"Lowest Trial Output   : {min_prob:.7f}")
    print(f"Highest Trial Output  : {max_prob:.7f}")
    print("="*40)

# Run the 100 trials
run_multiple_trials(num_trials=100, stream_length=1000000)
