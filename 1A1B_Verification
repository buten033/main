import numpy as np

def generate_stochastic_stream(probability, length=100000):
    """Generates a random bit stream for a given probability."""
    return (np.random.rand(length) < probability).astype(int)

def simulate_circuit_1a(x_prob, num_bits=100000):
    """Simulates the stochastic circuit for f(x) = x - x^2 / 4."""
    
    # 1. Generate two INDEPENDENT streams for the variable x
    x_stream_1 = generate_stochastic_stream(x_prob, num_bits)
    x_stream_2 = generate_stochastic_stream(x_prob, num_bits)
    
    # 2. Generate constant probability streams for the Bernstein coefficients
    c0_stream = generate_stochastic_stream(0.0, num_bits)    # c0 = 0
    c1_stream = generate_stochastic_stream(0.5, num_bits)    # c1 = 1/2
    c2_stream = generate_stochastic_stream(0.75, num_bits)   # c2 = 3/4
    
    # 3. Adder block: counts the number of 1s among the two x inputs
    adder_output = x_stream_1 + x_stream_2
    
    # 4. Multiplexer block: selects based on the adder's output
    output_stream = np.zeros(num_bits, dtype=int)
    
    # MUX logic
    output_stream = np.where(adder_output == 0, c0_stream, output_stream)
    output_stream = np.where(adder_output == 1, c1_stream, output_stream)
    output_stream = np.where(adder_output == 2, c2_stream, output_stream)
    
    # Calculate the empirical probability of the output stream
    simulated_prob = np.mean(output_stream)
    expected_prob = x_prob - (x_prob**2) / 4.0
    
    print(f"Input x: {x_prob}")
    print(f"Expected output (Math) : {expected_prob:.4f}")
    print(f"Simulated output (Stoc): {simulated_prob:.4f}")
    print("-" * 30)

# Test with a few probabilities
test_values = [0.0, 0.25, 0.5, 0.75, 1.0]
for val in test_values:
    simulate_circuit_1a(val)


#BELOW IS FOR 1B 
import numpy as np
import math

def generate_stochastic_stream(probability, length=200000):
    """Generates a random bit stream for a given probability."""
    return (np.random.rand(length) < probability).astype(int)

def verify_bernstein_model(x_prob, num_bits=200000):
    """Verifies the derived 4th-degree Bernstein polynomial for cos(x)."""
    
    # ---------------------------------------------------------
    # 1. THEORETICAL MATH VERIFICATION
    # ---------------------------------------------------------
    true_cos = math.cos(x_prob)
    expected_maclaurin = 1.0 - 0.5 * (x_prob**2) + (1.0 / 24.0) * (x_prob**4)
    
    # Evaluate the explicit Bernstein polynomial you derived:
    # A=1, B=1, C=11/12, D=3/4, E=13/24
    term_A = 1.0 * ((1 - x_prob)**4)
    term_B = 1.0 * (4 * x_prob * (1 - x_prob)**3)
    term_C = (11.0 / 12.0) * (6 * (x_prob**2) * ((1 - x_prob)**2))
    term_D = (3.0 / 4.0)  * (4 * (x_prob**3) * (1 - x_prob))
    term_E = (13.0 / 24.0) * (x_prob**4)
    
    expected_bernstein = term_A + term_B + term_C + term_D + term_E
    
    # ---------------------------------------------------------
    # 2. STOCHASTIC CIRCUIT SIMULATION
    # ---------------------------------------------------------
    # Generate 4 independent streams for the input variable x
    x1 = generate_stochastic_stream(x_prob, num_bits)
    x2 = generate_stochastic_stream(x_prob, num_bits)
    x3 = generate_stochastic_stream(x_prob, num_bits)
    x4 = generate_stochastic_stream(x_prob, num_bits)
    
    # Generate constant probability streams for the Bernstein coefficients
    c0 = generate_stochastic_stream(1.0, num_bits)
    c1 = generate_stochastic_stream(1.0, num_bits)
    c2 = generate_stochastic_stream(11.0 / 12.0, num_bits)
    c3 = generate_stochastic_stream(3.0 / 4.0, num_bits)  # Coefficient D = 3/4
    c4 = generate_stochastic_stream(13.0 / 24.0, num_bits)
    
    # Adder block: counts the number of 1s among the 4 x inputs
    adder_output = x1 + x2 + x3 + x4
    
    # Multiplexer block: selects based on the adder's output
    output_stream = np.zeros(num_bits, dtype=int)
    output_stream = np.where(adder_output == 0, c0, output_stream)
    output_stream = np.where(adder_output == 1, c1, output_stream)
    output_stream = np.where(adder_output == 2, c2, output_stream)
    output_stream = np.where(adder_output == 3, c3, output_stream)
    output_stream = np.where(adder_output == 4, c4, output_stream)
    
    # Calculate the empirical probability of the stochastic output stream
    simulated_prob = np.mean(output_stream)
    
    # ---------------------------------------------------------
    # 3. PRINT RESULTS
    # ---------------------------------------------------------
    print(f"--- Input Probability x: {x_prob} ---")
    print(f"True math.cos(x)          : {true_cos:.6f}")
    print(f"Maclaurin Approx (Math)   : {expected_maclaurin:.6f}")
    print(f"Bernstein Equation (Math) : {expected_bernstein:.6f}")
    print(f"Stochastic Hardware Sim   : {simulated_prob:.6f}")
    print("")

# Test with various probabilities between 0 and 1
test_values = [0.0, 0.25, 0.5, 0.75, 1.0]
for val in test_values:
    verify_bernstein_model(val)
    
