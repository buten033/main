# ── Build species index ──────────────────────────────────────────────────────
def parse_side(tokens):
    """Parse 'A n B m ...' into {name: stoich} dict."""
    result = {}
    i = 0
    while i < len(tokens):
        name = tokens[i]
        count = int(tokens[i+1]) if i+1 < len(tokens) and tokens[i+1].lstrip('-').isdigit() else 1
        result[name] = result.get(name, 0) + count
        i += 2
    return result

# Collect all species names
all_species = set()
reactions_raw = []
for line in LAMBDA_R.strip().splitlines():
    line = line.strip()
    if not line:
        continue
    parts = line.split(':')
    lhs_tokens = parts[0].strip().split()
    rhs_tokens = parts[1].strip().split()
    rate = float(parts[2].strip())
    lhs = parse_side(lhs_tokens)
    rhs = parse_side(rhs_tokens)
    all_species.update(lhs.keys())
    all_species.update(rhs.keys())
    reactions_raw.append((lhs, rhs, rate))

species_list = sorted(all_species)
sp_idx = {s: i for i, s in enumerate(species_list)}
n_species = len(species_list)
n_reactions = len(reactions_raw)

print(f"Species: {n_species}, Reactions: {n_reactions}")

# ── Build stoichiometry and reactant arrays ──────────────────────────────────
# stoich[r, s] = net change in species s when reaction r fires
stoich = np.zeros((n_reactions, n_species), dtype=np.int64)
# reactants[r, s] = how many of species s are consumed (for propensity)
reactants = np.zeros((n_reactions, n_species), dtype=np.int64)
rates = np.zeros(n_reactions, dtype=np.float64)

for r, (lhs, rhs, rate) in enumerate(reactions_raw):
    rates[r] = rate
    for sp, cnt in lhs.items():
        reactants[r, sp_idx[sp]] = cnt
        stoich[r, sp_idx[sp]] -= cnt
    for sp, cnt in rhs.items():
        stoich[r, sp_idx[sp]] += cnt

# ── Parse initial conditions ─────────────────────────────────────────────────
base_ic = np.zeros(n_species, dtype=np.int64)
for line in LAMBDA_IN.strip().splitlines():
    line = line.strip()
    if not line:
        continue
    tokens = line.split()
    name, val = tokens[0], int(tokens[1])
    if name in sp_idx:
        base_ic[sp_idx[name]] = val

moi_idx   = sp_idx['MOI']
cI2_idx   = sp_idx['cI2']
Cro2_idx  = sp_idx['Cro2']

# ── Numba Gillespie ──────────────────────────────────────────────────────────
@njit
def propensity(state, reactants, rates, n_reactions, n_species):
    a = np.empty(n_reactions)
    for r in range(n_reactions):
        prop = rates[r]
        for s in range(n_species):
            req = reactants[r, s]
            if req == 0:
                continue
            x = state[s]
            if x < req:
                prop = 0.0
                break
            # combinatorial: x*(x-1)*.../(req!) for req molecules
            for k in range(req):
                prop *= (x - k)
            for k in range(1, req + 1):
                prop /= k
        a[r] = prop
    return a

@njit
def gillespie_run(ic, stoich, reactants, rates, n_reactions, n_species,
                  cI2_idx, Cro2_idx, max_steps=500_000):
    state = ic.copy()
    for _ in range(max_steps):
        # check termination
        if state[cI2_idx] > 145:
            return 1   # stealth
        if state[Cro2_idx] > 55:
            return 2   # hijack

        a = propensity(state, reactants, rates, n_reactions, n_species)
        a0 = 0.0
        for i in range(n_reactions):
            a0 += a[i]
        if a0 == 0.0:
            return 0   # stuck

        r_val = np.random.random() * a0
        cumsum = 0.0
        fired = -1
        for r in range(n_reactions):
            cumsum += a[r]
            if r_val < cumsum:
                fired = r
                break

        for s in range(n_species):
            state[s] += stoich[fired, s]
            if state[s] < 0:
                state[s] = 0

    return 0  # undecided

# ── JIT warmup ───────────────────────────────────────────────────────────────
_ic_warm = base_ic.copy()
gillespie_run(_ic_warm, stoich, reactants, rates, n_reactions, n_species,
              cI2_idx, Cro2_idx, max_steps=1)
print("JIT compiled. Running simulations...\n")

# ── Sweep MOI = 1..10 with tqdm progress bar ─────────────────────────────────
from tqdm import tqdm

N_TRIALS = 1000

print(f"{'MOI':>4}  {'Pr(stealth)':>12}  {'Pr(hijack)':>11}  {'Undecided':>10}")
print("-" * 45)

for moi in range(1, 11):
    stealth = hijack = 0
    ic_base = base_ic.copy()
    ic_base[moi_idx] = moi

    with tqdm(total=N_TRIALS, desc=f"MOI={moi:>2}", leave=False) as pbar:
        for _ in range(N_TRIALS):
            ic = ic_base.copy()
            result = gillespie_run(ic, stoich, reactants, rates,
                                   n_reactions, n_species, cI2_idx, Cro2_idx)
            if result == 1:
                stealth += 1
            elif result == 2:
                hijack += 1
            pbar.update(1)

    u = N_TRIALS - stealth - hijack
    print(f"{moi:>4}  {stealth/N_TRIALS:>12.4f}  {hijack/N_TRIALS:>11.4f}  {u/N_TRIALS:>10.4f}")
